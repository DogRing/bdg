{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)"
    ],
    "ask": [
      "Bash(go mod:*)",
      "Bash(go get:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./secrets/**)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
  "PostToolUse": [
    { "matcher": "Write|Edit",
      "hooks": [{ "type": "command",
        "command": "cd /home/coder/workspace/bdg/backend && gofmt -l . && go vet ./... && go test ./..." }] }
    ]
  },
  "env": {
    "GOROOT": "/home/coder/go",
    "GOPATH": "/home/coder/go-workspace",
    "PATH": "/home/coder/go/bin:/home/coder/go-workspace/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  }
}