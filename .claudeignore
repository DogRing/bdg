# Context economy + sensitive exclusion.
# Keep SPECs, docs, glossary, architecture, content visible — agents need them.

# build artifacts / runtime
/bin/
/out/
/.data/
/vendor/
go.sum
go.work
go.work.sum

# frontend (added later)
/frontend/node_modules/
/frontend/dist/
node_modules/

# noise
*.log
*.tmp
.DS_Store

# secrets (never load into context)
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# large generated blobs (reviewer reads small goldens; large ones excluded)
/testdata/large/
*.snapshot.bin
