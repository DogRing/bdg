# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# bdg-sse: standalone, READ-ONLY SSE server (sse.dogring.kr).
# Tails the valkey event stream with a read-only user and forwards it over /sse.
# No simulation, no postgres, no content/ — horizontally scalable.
#
# Build from the REPO ROOT (only backend/ source is needed; no content):
#   docker build -f backend/Dockerfile.sse -t bdg-sse:dev .
#   docker run --rm --env-file deploy/.env -p 8081:8080 bdg-sse:dev
# ─────────────────────────────────────────────────────────────────────────────

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sse ./cmd/sse

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/sse /app/sse
ENV HTTP_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/sse"]
