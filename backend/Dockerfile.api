# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# bdg-backend: simulation writer + read/write HTTP API (gapi.dogring.kr).
# Runs the tick loop, writes live state + event stream to valkey, backs up to
# postgres, and serves /api/* (+ /sse). Single writer — deploy ONE replica.
#
# Build from the REPO ROOT (context must include backend/ AND content/):
#   docker build -f backend/Dockerfile.api -t bdg-backend:dev .
#   docker run --rm --env-file deploy/.env -p 8080:8080 bdg-backend:dev -ticks=0 -agents=200
# ─────────────────────────────────────────────────────────────────────────────

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/bdg .

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/bdg /app/bdg
COPY content/ /app/content/
ENV CONTENT_DIR=/app/content \
    HTTP_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/bdg"]
# Service mode (run until SIGTERM). Override args in k8s / docker run.
CMD ["-ticks=0"]
