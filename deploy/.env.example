# ─────────────────────────────────────────────────────────────────────────────
# bdg backend — deployment configuration template
#
# THIS IS THE ONLY FILE YOU EDIT to point the backend at infra.
#   cp deploy/.env.example deploy/.env      # then fill in the secrets below
#
# Format: plain KEY=value (no quotes, no inline comments). This works as-is with:
#   - local shell:   set -a; . deploy/.env; set +a; go run ./backend -ticks=0
#   - docker:        docker run --env-file deploy/.env ...
#   - kubernetes:    kubectl create secret generic bdg-backend-env \
#                        --from-env-file=deploy/.env -n bdg
#
# deploy/.env is git-ignored (only .env.example is committed). Never commit real
# passwords.
# ─────────────────────────────────────────────────────────────────────────────

# ── Run identity ─────────────────────────────────────────────────────────────
# RUN_ID is the Redis/Postgres keyspace prefix. Use a fresh id per run so a new
# deploy does not collide with an old run's live keys.
RUN_ID=dev
SEED=1

# ── Valkey (Redis) — live store + event stream + SSE source ──────────────────
# Empty REDIS_ADDR disables the live/SSE tier (batch-only mode).
REDIS_ADDR=valkey-primary.valkey.svc.cluster.local:6379
REDIS_DB=0
# Primary (read+write) user — the simulation writer needs this. If your valkey
# has no ACL/auth, leave USERNAME/PASSWORD empty.
REDIS_USERNAME=default
REDIS_PASSWORD=default-pw
# Read-only user — backs the api + /sse read path only. If unset, the read path
# reuses the primary credentials above. Set this to the read-only id you created
# so the public SSE/api boundary cannot write.
REDIS_RO_USERNAME=default-reader
REDIS_RO_PASSWORD=default-reader-pw

# ── Postgres — periodic backup + why-trace (internal only) ───────────────────
# Full DSN carries its own user:password. Empty disables backups.
# sslmode=disable is fine for in-cluster traffic; use require/verify-full if TLS.
POSTGRES_DSN=postgres://bdg:bdg_pw@postgres.postgres.svc.cluster.local:5432/bdg?sslmode=disable

# ── HTTP / API ───────────────────────────────────────────────────────────────
# Listen address inside the container. The Service/Ingress front this port.
HTTP_ADDR=:8080
# GOD_MODE=true enables the gated /api/god/* endpoints + real_stats merge.
# Keep false on anything publicly reachable (gapi/sse).
GOD_MODE=false

# ── Cadence ──────────────────────────────────────────────────────────────────
# Snapshot/backup every N ticks (0 or unset = use content/balance.yaml default).
BACKUP_EVERY_TICKS=60

# ── Content ──────────────────────────────────────────────────────────────────
# Path to the content/ directory inside the image (set in the Dockerfile).
CONTENT_DIR=/app/content
